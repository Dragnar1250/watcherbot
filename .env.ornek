# Bu dosyanın adını ".env" yap ve token'ını yapıştır.
DISCORD_TOKEN=BURAYA_TOKEN

# İsteğe bağlı: test sunucunun ID'si. Yazarsan komutlar o sunucuda anında görünür.
TEST_SUNUCU_ID=

# İsteğe bağlı: 1 yazarsan bot açıkken Windows uyku moduna geçmez.
UYKU_ENGELLE=0

# Otomatik güncelleme (GitHub). Depo adını kullaniciadi/depoadi şeklinde yaz. Boş bırakırsan güncelleme kapalı olur.
GUNCELLEME_DEPO=
GUNCELLEME_DALI=main
# Sadece depo gizliyse gerekir (GitHub → Settings → Developer settings → Fine-grained token, sadece okuma).
GITHUB_TOKEN=
# 0 yazarsan otomatik kontrol kapanır (/guncelle komutu yine çalışır).
OTOMATIK_GUNCELLEME=1
